# Required: a search key and ONE LLM key (Anthropic or OpenAI).
TAVILY_API_KEY=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Recommended: people search by job title + email reveal (email reveal spends Apollo credits).
APOLLO_API_KEY=

# Website tech stack is detected for free with open-source fingerprints. BuiltWith is a paid
# extra ($295+/month) and not needed; leave empty.
BUILTWITH_API_KEY=

# Optional: force a provider when both LLM keys are set ("anthropic" or "openai").
LLM_PROVIDER=
LLM_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-5.6-sol

# Optional tuning
LOOKBACK_DAYS=365
RESULTS_PER_QUERY=6
MAX_CONTACTS_PER_INITIATIVE=5
# DB_PATH=data/accountscope.db

# Caching: "Research again" always searches fresh; other runs within this window re-use stored pages.
SOURCE_CACHE_HOURS=24
PEOPLE_CACHE_DAYS=30

# Watchlists: watched accounts are re-researched this often while the app is running.
WATCH_INTERVAL_DAYS=7
WATCH_SCHEDULER=on

# LinkedIn connection note limit: 300 with Premium, 200 on free accounts
CONNECTION_NOTE_MAX=280

# Sign-in. On by default: the first visit asks you to create the owner account.
# Set to off to use the app alone on this machine without signing in.
REQUIRE_LOGIN=on
